local pages   = {}
local tabBtns = {}

local function switchTab(name)
    for n,p  in pairs(pages)   do p.Visible = (n==name) end
    for n,tb in pairs(tabBtns) do
        tb.BackgroundColor3 = (n==name) and C.BLUE or C.PANEL
        tb.TextColor3       = (n==name) and C.WHITE or C.DIM
    end
end

local tabW = W/#TABS
for i, name in ipairs(TABS) do
    local tb = Instance.new("TextButton", TabBar)
    tb.Size             = UDim2.fromOffset(tabW, 28)
    tb.BackgroundColor3 = C.PANEL; tb.BorderSizePixel = 0
    tb.Text             = name
    tb.Font             = Enum.Font.GothamBold; tb.TextSize = 10
    tb.TextColor3       = C.DIM; tb.AutoButtonColor = false
    tb.LayoutOrder      = i
    tb.MouseButton1Click:Connect(function() switchTab(name) end)
    tabBtns[name] = tb

    local page = Instance.new("Frame", Content)
    page.Size               = UDim2.new(1,0,1,0)
    page.BackgroundTransparency = 1; page.Visible = false
    pages[name] = page
end

