local function createWorldMessage(text, isServer)
    if isServer then
        local remote = ReplicatedStorage:FindFirstChild("Message") or ReplicatedStorage:FindFirstChild("ServerMessage")
        if remote then remote:FireServer(text) end
    else
        local billboard = Instance.new("BillboardGui")
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.Adornee = LocalPlayer.Character:FindFirstChild("Head")
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = LocalPlayer.Character:FindFirstChild("Head")

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = text
        label.TextColor3 = Color3.new(1, 1, 1)
        label.Font = Theme.Font
        label.TextSize = 20
        label.Parent = billboard

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 2
        stroke.Color = Color3.new(0, 0, 0)
        stroke.Parent = label

        task.delay(5, function() billboard:Destroy() end)
    end
end

