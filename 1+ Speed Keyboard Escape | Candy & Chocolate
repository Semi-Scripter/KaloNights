-- ── TAB: PLAYERS ────────────────────────────────────────────
-- ═══════════════════════════════════════════════════════════
do
    local scroll = makeScroll(pages["Players"])
    local selectedPlayer = nil

    local selBanner = Instance.new("TextLabel", scroll)
    selBanner.Size             = UDim2.new(1,0,0,24)
    selBanner.BackgroundColor3 = C.PANEL; selBanner.BorderSizePixel = 0
    selBanner.Font             = Enum.Font.GothamBold; selBanner.TextSize = 11
    selBanner.TextColor3       = C.TEXT; selBanner.LayoutOrder = 0
    selBanner.Text             = "  Selected: none"
    selBanner.TextXAlignment   = Enum.TextXAlignment.Left
    Instance.new("UICorner", selBanner).CornerRadius = UDim.new(0,6)

    makeLabel(scroll, "PLAYER LIST", 1)

    local plHolder = Instance.new("Frame", scroll)
    plHolder.Size               = UDim2.new(1,0,0,0)
    plHolder.BackgroundTransparency = 1; plHolder.BorderSizePixel = 0
    plHolder.LayoutOrder        = 2
    local plLay = Instance.new("UIListLayout", plHolder)
    plLay.SortOrder = Enum.SortOrder.LayoutOrder; plLay.Padding = UDim.new(0,3)
    plLay:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        plHolder.Size = UDim2.new(1,0,0,plLay.AbsoluteContentSize.Y)
    end)

    local plBtns = {}

    local function refreshPlayers()
        for _,b in pairs(plBtns) do b:Destroy() end
        table.clear(plBtns)
        for i, plr in ipairs(Players:GetPlayers()) do
            local isMe = (plr == LP)
            local b = Instance.new("TextButton", plHolder)
            b.Size             = UDim2.new(1,0,0,26)
            b.BackgroundColor3 = isMe and Color3.fromRGB(25,45,25) or C.BTN
            b.BorderSizePixel  = 0; b.LayoutOrder = i
            b.Font             = Enum.Font.Gotham; b.TextSize = 11
            b.TextColor3       = isMe and C.GREEN or C.TEXT
            b.Text             = (isMe and "★  " or "   ") .. plr.Name
            b.TextXAlignment   = Enum.TextXAlignment.Left
            b.AutoButtonColor  = false
            Instance.new("UICorner", b).CornerRadius = UDim.new(0,5)
            b.MouseButton1Click:Connect(function()
                selectedPlayer = plr
                selBanner.Text = "  Selected: " .. plr.Name
                for _, btn in pairs(plBtns) do
                    btn.BackgroundColor3 = (btn==b) and C.BLUE
                        or (Players:FindFirstChild(btn.Text:gsub("★  ",""):gsub("   ",""))==LP
                            and Color3.fromRGB(25,45,25) or C.BTN)
                    btn.TextColor3 = (btn==b) and C.WHITE or C.TEXT
                end
            end)
            table.insert(plBtns, b)
        end
    end

    refreshPlayers()
    Players.PlayerAdded:Connect(refreshPlayers)
    Players.PlayerRemoving:Connect(refreshPlayers)

    -- ── ACTIONS ─────────────────────────────────────────────
    makeSep(scroll, 3)
    makeLabel(scroll, "ACTIONS  (click a player first)", 4)

    local function act(text, color, order, actionFn)
        local b = makeBtn(scroll, text, color, order)
        b.MouseButton1Click:Connect(function()
            if not selectedPlayer then
                selBanner.Text = "  ⚠  Select a player first!"
                return
            end
            actionFn(selectedPlayer)
        end)
        return b
    end

    act("⛔  Kick Player",            C.RED,    5,  function(p)
        fireServer("Kick", p.Name, "Kicked by admin.")
    end)
    act("📌  Teleport to Me",         C.BLUE,   6,  function(p)
        local myChar = LP.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            fireServer("TeleportTo", p.Name, myChar.HumanoidRootPart.Position)
        end
    end)
    act("🧲  Bring to Me",            C.PURPLE, 7,  function(p)
        local myChar = LP.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            fireServer("TeleportTo", p.Name, myChar.HumanoidRootPart.Position)
        end
    end)
    act("🔄  Respawn Player",         C.GREEN,  8,  function(p)
        fireServer("Respawn", p.Name)
    end)
    act("🧊  Freeze / Unfreeze",      C.TEAL,   9,  function(p)
        fireServer("Freeze", p.Name)
    end)
    act("⚡  Speed Boost (80)",       C.ORANGE, 10, function(p)
        fireServer("SetSpeed", p.Name, 80)
    end)
    act("🚶  Reset Speed (16)",       C.BTN,    11, function(p)
        fireServer("SetSpeed", p.Name, 16)
    end)
    act("🎁  Give Tool",              C.ORANGE, 12, function(p)
        fireServer("GiveTool", p.Name)
    end)

    -- Spectate (local, no server needed)
    local specBtn  = makeBtn(scroll, "👁  Spectate Player", C.BTN, 13)
    local specConn = nil
    local specOn   = false
    specBtn.MouseButton1Click:Connect(function()
        if not selectedPlayer then
            selBanner.Text = "  ⚠  Select a player first!"; return
        end
        specOn = not specOn
        specBtn.Text             = specOn and "👁  Stop Spectating" or "👁  Spectate Player"
        specBtn.BackgroundColor3 = specOn and C.BLUE or C.BTN
        hover(specBtn, specOn and C.BLUE or C.BTN)
        if specOn then
            workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
            specConn = RunService.RenderStepped:Connect(function()
                if not selectedPlayer or not selectedPlayer.Character then
                    specOn=false; specBtn.Text="👁  Spectate Player"
                    specBtn.BackgroundColor3=C.BTN
                    workspace.CurrentCamera.CameraType=Enum.CameraType.Custom
                    specConn:Disconnect(); return
                end
                local head = selectedPlayer.Character:FindFirstChild("Head")
                if head then
                    workspace.CurrentCamera.CFrame = CFrame.new(
                        head.Position + Vector3.new(0,3,7), head.Position)
                end
            end)
        else
            if specConn then specConn:Disconnect() end
            workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
        end
    end)
end

