-- ── WAIT FOR SERVER REMOTE ──────────────────────────────────
-- The companion ServerScript creates "AdminRemote" in RS.
-- We wait up to 10 seconds; if not found, server actions
-- (kick, teleport others, etc.) will be disabled.
local adminRemote = nil
task.spawn(function()
    local found = RS:WaitForChild("AdminRemote", 10)
    if found then
        adminRemote = found
    else
        warn("[AdminPanel] AdminRemote not found. Server actions disabled.")
        warn("[AdminPanel] Add the companion ServerScript to ServerScriptService.")
    end
end)

local function fireServer(...)
    if adminRemote then
        adminRemote:FireServer(...)
    else
        warn("[AdminPanel] No server remote — server action skipped.")
    end
end

