local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local Chat    = game:GetService("Chat")

-- Same admin list — keep in sync with the LocalScript
local ADMINS = {
    [1] = true,   -- ← your UserId
}

-- Create the remote only once
local re = Instance.new("RemoteEvent", RS)
re.Name  = "AdminRemote"

re.OnServerEvent:Connect(function(sender, action, target, extra)
    -- Security: verify the sender is actually an admin
    if not ADMINS[sender.UserId] then return end

    local targetPlr = Players:FindFirstChild(tostring(target))

    if action == "Kick" then
        if targetPlr and targetPlr ~= sender then
            targetPlr:Kick(tostring(extra) or "Kicked by admin.")
        end

    elseif action == "TeleportTo" then
        if targetPlr and targetPlr.Character and extra then
            local hrp = targetPlr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.CFrame = CFrame.new(extra + Vector3.new(0,3,0)) end
        end

    elseif action == "Respawn" then
        if targetPlr then targetPlr:LoadCharacter() end

    elseif action == "Freeze" then
        if targetPlr and targetPlr.Character then
            local hum = targetPlr.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = hum.WalkSpeed > 0 and 0 or 16 end
        end

    elseif action == "SetSpeed" then
        if targetPlr and targetPlr.Character then
            local hum = targetPlr.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = tonumber(extra) or 16 end
        end

    elseif action == "Announce" then
        for _, plr in ipairs(Players:GetPlayers()) do
            local head = plr.Character and plr.Character:FindFirstChild("Head")
            Chat:Chat(head or workspace.Terrain, "[ADMIN] " .. tostring(extra))
        end

    elseif action == "GiveTool" then
        if targetPlr then
            local tool = RS:FindFirstChildOfClass("Tool")
            if tool then tool:Clone().Parent = targetPlr.Backpack end
        end
    end
end)

print("[AdminPanel] Server remote ready.")
