-- 1. Security Debug (The "Anti" Toggle)
local securityActive = true
local secBtn = createBtn("Security: ACTIVE", Color3.fromRGB(46, 204, 113), function() end)
secBtn.MouseButton1Click:Connect(function()
    securityActive = not securityActive
    if not securityActive then
        secBtn.Text = "Security: DISABLED"
        secBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
        local targets = {"AntiTrip", "KeySystem v7 by Sano", "StepDetectionSystem", "InteractionSystem"}
        for _, name in ipairs(targets) do
            local s = game:FindFirstChild(name, true)
            if s and s:IsA("BaseScript") then s.Disabled = true end
        end
    else
        secBtn.Text = "Security: ACTIVE"
        secBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
    end
end)

-- 2. Speed Control (Infinite/Normal)
local isInfinite = false
local speedBtn = createBtn("Speed: Normal", Color3.fromRGB(52, 152, 219), function() end)
speedBtn.MouseButton1Click:Connect(function()
    isInfinite = not isInfinite
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
    if isInfinite then
        speedBtn.Text = "Speed: ∞ (Infinite)"
        speedBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
        if hum then hum.WalkSpeed = 1000 end
        if UpdateSpeedRemote then UpdateSpeedRemote:FireServer(1000) end
    else
        speedBtn.Text = "Speed: Normal"
        speedBtn.BackgroundColor3 = Color3.fromRGB(52, 152, 219)
        if hum then hum.WalkSpeed = 16 end
        if UpdateSpeedRemote then UpdateSpeedRemote:FireServer(16) end
    end
end)

-- 3. Noclip (Ghost Mode)
local noclipActive = false
local noclipBtn = createBtn("Noclip: OFF", Color3.fromRGB(127, 140, 141), function() end)
noclipBtn.MouseButton1Click:Connect(function()
    noclipActive = not noclipActive
    noclipBtn.Text = noclipActive and "Noclip: ON" or "Noclip: OFF"
    noclipBtn.BackgroundColor3 = noclipActive and Color3.fromRGB(241, 196, 15) or Color3.fromRGB(127, 140, 141)
end)

RunService.Stepped:Connect(function()
    if noclipActive and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
end)

