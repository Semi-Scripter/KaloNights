-- ============================================================
-- Core Logic
-- ============================================================
local isEnabled = false
local loopConnection = nil

local function pickUpEmeralds()
    local droppedItems = workspace:FindFirstChild("DroppedItems")
    if not droppedItems then return end

    for _, model in ipairs(droppedItems:GetChildren()) do
        if model:IsA("Model") and model.Name == "Emerald" then
            local primaryPart = model.PrimaryPart
            if primaryPart then
                PickUpItem:FireServer(model)
            end
        end
    end
end

local function startLoop()
    if loopConnection then return end
    local elapsed = 0
    loopConnection = RunService.Heartbeat:Connect(function(dt)
        elapsed = elapsed + dt
        if elapsed >= 0.5 then
            elapsed = 0
            pickUpEmeralds()
        end
    end)
end

local function stopLoop()
    if loopConnection then
        loopConnection:Disconnect()
        loopConnection = nil
    end
end

-- Toggle handler
toggleButton.MouseButton1Click:Connect(function()
    isEnabled = not isEnabled
    if isEnabled then
        toggleButton.Text = "Emeralds Toggle: ON"
        toggleButton.BackgroundColor3 = Color3.fromRGB(40, 200, 100)
        statusLabel.Text = "Status: Scanning every 0.5s"
        statusLabel.TextColor3 = Color3.fromRGB(80, 220, 130)
        startLoop()
    else
        toggleButton.Text = "Emeralds Toggle: OFF"
        toggleButton.BackgroundColor3 = Color3.fromRGB(50, 160, 90)
        statusLabel.Text = "Status: OFF"
        statusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        stopLoop()
    end
end)

