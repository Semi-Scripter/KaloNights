ToggleBtn.MouseButton1Click:Connect(function()
	-- Button press pulse animation
	local tIn  = TweenService:Create(ToggleBtn, TweenInfo.new(0.07), {Size = UDim2.new(1, -26, 0, 24)})
	local tOut = TweenService:Create(ToggleBtn, TweenInfo.new(0.1),  {Size = UDim2.new(1, -20, 0, 28)})
	tIn:Play()
	tIn.Completed:Connect(function() tOut:Play() end)

	if isActive then
		stopPickup()
	else
		startPickup()
	end
end)

CloseBtn.MouseButton1Click:Connect(function()
	stopPickup()
	ScreenGui:Destroy()
end)

