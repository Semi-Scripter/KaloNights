local Tabs    = {}
local TabBtns = {}
local ActiveTab = nil

local function MakeTabPage(name, icon)
    local page = Instance.new("Frame")
    page.Name             = name
    page.Size             = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible          = false
    page.Parent           = ContentArea

    local tabBtn = Instance.new("TextButton")
    tabBtn.Size             = UDim2.new(1, 0, 0, 34)
    tabBtn.BackgroundColor3 = BG_MID
    tabBtn.BorderSizePixel  = 0
    tabBtn.Text             = icon .. "  " .. name
    tabBtn.TextColor3       = TEXT_DIM
    tabBtn.Font             = Enum.Font.GothamMedium
    tabBtn.TextSize         = 12
    tabBtn.AutoButtonColor  = false
    tabBtn.LayoutOrder      = #Tabs + 1
    tabBtn.Parent           = TabBar
    local tbc = Instance.new("UICorner")
    tbc.CornerRadius = UDim.new(0, 6)
    tbc.Parent = tabBtn

    tabBtn.MouseButton1Click:Connect(function()
        if ActiveTab then
            ActiveTab.page.Visible       = false
            ActiveTab.btn.BackgroundColor3 = BG_MID
            ActiveTab.btn.TextColor3       = TEXT_DIM
        end
        page.Visible         = true
        tabBtn.BackgroundColor3 = ACCENT
        tabBtn.TextColor3       = Color3.new(1, 1, 1)
        ActiveTab = {page = page, btn = tabBtn}
    end)

    Tabs[name]    = page
    TabBtns[name] = tabBtn
    return page
end

