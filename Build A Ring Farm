-- ================================================================
-- GLOBAL METAMETHOD HOOKS (set once — survive respawns)
-- These intercept damage at the engine level before Lua even sees it.
-- hookmetamethod is a standard executor API (Synapse, KRNL, Fluxus, etc.)
-- Both hooks are wrapped in pcall so they silently skip if not supported.
-- ================================================================
local function getHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

-- ── Hook 1: __namecall — blocks humanoid:TakeDamage() calls ──────
pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        if GodEnabled then
            local method = getnamecallmethod()
            if method == "TakeDamage" then
                local hum = getHumanoid()
                if hum and self == hum then
                    return  -- swallow the damage call entirely
                end
            end
        end
        return oldNamecall(self, ...)
    end))
end)

-- ── Hook 2: __newindex — blocks any write to humanoid.Health ─────
pcall(function()
    local oldNewindex
    oldNewindex = hookmetamethod(game, "__newindex", newcclosure(function(self, key, value)
        if GodEnabled then
            local hum = getHumanoid()
            if hum and self == hum then
                if key == "Health" or key == "MaxHealth" then
                    return oldNewindex(self, key, math.huge)
                end
            end
        end
        return oldNewindex(self, key, value)
    end))
end)

-- ================================================================
-- SERVER REMOTE SETUP
-- Registers a RemoteFunction so the server can apply a real
-- ForceField and health lock when executor access allows it.
-- ================================================================
local GodRemote
pcall(function()
    local folder = ReplicatedStorage:FindFirstChild("_GodValidation")
        or (function()
            local f = Instance.new("Folder")
            f.Name   = "_GodValidation"
            f.Parent = ReplicatedStorage
            return f
        end)()

    GodRemote = folder:FindFirstChild("GodToggle")
    if not GodRemote then
        GodRemote = Instance.new("RemoteFunction")
        GodRemote.Name   = "GodToggle"
        GodRemote.Parent = folder
    end

    GodRemote.OnServerInvoke = function(player, state)
        local char = player.Character
        if not char then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return false end

        if state then
            if not char:FindFirstChildOfClass("ForceField") then
                local ff = Instance.new("ForceField")
                ff.Visible = false
                ff.Parent  = char
            end
            hum.MaxHealth = math.huge
            hum.Health    = math.huge

            if not char:FindFirstChild("_GodTag") then
                local tag      = Instance.new("BoolValue")
                tag.Name       = "_GodTag"
                tag.Parent     = char

                task.spawn(function()
                    while char:FindFirstChild("_GodTag") do
                        if hum and hum.Parent then
                            hum.MaxHealth = math.huge
                            hum.Health    = math.huge
                            pcall(function()
                                hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                            end)
                        end
                        task.wait(0.05)
                    end
                end)
            end
        else
            local ff  = char:FindFirstChildOfClass("ForceField")
            if ff then ff:Destroy() end
            local tag = char:FindFirstChild("_GodTag")
            if tag then tag:Destroy() end
            hum.MaxHealth = 100
            hum.Health    = 100
        end
        return true
    end
end)

