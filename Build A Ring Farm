-- ============================================================
-- SHIELD BILLBOARD (visual indicator above head)
-- ============================================================
local function createShield(character)
    if ShieldBill then ShieldBill:Destroy() end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    ShieldBill = Instance.new("BillboardGui")
    ShieldBill.Size         = UDim2.new(0, 55, 0, 55)
    ShieldBill.StudsOffset  = Vector3.new(0, 3.5, 0)
    ShieldBill.AlwaysOnTop  = false
    ShieldBill.Adornee      = root
    ShieldBill.Parent       = root

    local lbl = Instance.new("TextLabel")
    lbl.Size                  = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text                  = "🛡"
    lbl.TextScaled            = true
    lbl.Font                  = Enum.Font.GothamBold
    lbl.Parent                = ShieldBill
end

local function removeShield()
    if ShieldBill then
        ShieldBill:Destroy()
        ShieldBill = nil
    end
end

-- ============================================================
-- CORE GOD LOGIC
-- ============================================================
local function disconnectAll()
    for _, c in ipairs(Connections) do
        pcall(function()
            if typeof(c) == "RBXScriptConnection" and c.Connected then
                c:Disconnect()
            elseif type(c) == "table" and c.Disconnect then
                c:Disconnect()
            end
        end)
    end
    Connections = {}
end

local function applyClientGod(character)
    if not character then return end
    local humanoid = character:WaitForChild("Humanoid", 5)
    if not humanoid then return end

    -- Instantly max health
    humanoid.MaxHealth = math.huge
    humanoid.Health    = math.huge

    -- Block every incoming health reduction
    Connections[#Connections + 1] = humanoid.HealthChanged:Connect(function(hp)
        if GodEnabled and hp < math.huge then
            humanoid.Health = math.huge
        end
    end)

    -- HeartBeat failsafe — catches anything HealthChanged misses
    Connections[#Connections + 1] = RunService.Heartbeat:Connect(function()
        if not GodEnabled then return end
        if not humanoid or not humanoid.Parent then return end

        if humanoid.Health < math.huge then
            humanoid.Health = math.huge
        end
        if humanoid.MaxHealth < math.huge then
            humanoid.MaxHealth = math.huge
        end

        -- Prevent dead state
        local st = humanoid:GetState()
        if st == Enum.HumanoidStateType.Dead then
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end)

    -- Try to also hook every BasePart's Touched to nerf NPC/mob damage
    -- by ensuring health stays pinned before any damage script fires
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            Connections[#Connections + 1] = part.Touched:Connect(function(_)
                if GodEnabled and humanoid and humanoid.Parent then
                    humanoid.Health    = math.huge
                    humanoid.MaxHealth = math.huge
                end
            end)
        end
    end

    createShield(character)

    -- Server validation call (best-effort — silent if game blocks it)
    pcall(function()
        GodRemote:InvokeServer(true)
    end)
end

local function enableGod()
    GodEnabled = true

    StatusLabel.Text       = "Status: ON  ✓"
    StatusLabel.TextColor3 = Color3.fromRGB(60, 230, 110)
    Btn.Text               = "Disable"

    TweenService:Create(Btn,    TweenInfo.new(0.25), { BackgroundColor3 = Color3.fromRGB(35, 185, 75) }):Play()
    TweenService:Create(Stroke, TweenInfo.new(0.25), { Color = Color3.fromRGB(60, 230, 110) }):Play()

    -- Apply to current character
    local char = LocalPlayer.Character
    if char then applyClientGod(char) end

    -- Re-apply on every respawn
    Connections[#Connections + 1] = LocalPlayer.CharacterAdded:Connect(function(newChar)
        if GodEnabled then
            task.wait(0.6)
            applyClientGod(newChar)
        end
    end)
end

local function disableGod()
    GodEnabled = false
    disconnectAll()
    removeShield()

    StatusLabel.Text       = "Status: OFF"
    StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
    Btn.Text               = "Enable"

    TweenService:Create(Btn,    TweenInfo.new(0.25), { BackgroundColor3 = Color3.fromRGB(220, 55, 55) }):Play()
    TweenService:Create(Stroke, TweenInfo.new(0.25), { Color = Color3.fromRGB(70, 70, 210) }):Play()

    -- Restore character to normal
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.MaxHealth = 100
            humanoid.Health    = 100
        end
        local ff = char:FindFirstChildOfClass("ForceField")
        if ff then ff:Destroy() end
    end

    -- Server: disable server-side lock
    pcall(function()
        GodRemote:InvokeServer(false)
    end)
end

-- ============================================================
-- TOGGLE BUTTON
-- ============================================================
Btn.MouseButton1Click:Connect(function()
    if GodEnabled then
        disableGod()
    else
        enableGod()
    end
end)

