    local oldNI
    oldNI = hookmetamethod(game, "__newindex", newcclosure(function(self, key, val)
        if godEnabled then
            local hum = getHum()
            if hum and self == hum and (key == "Health" or key == "MaxHealth") then
                return oldNI(self, key, math.huge)
