        for _, crate in ipairs(crates:GetDescendants()) do
            if crate:IsA("BasePart") and crate.Name == "Crate" then
                local d = (crate.Position - hrp.Position).Magnitude
                if d < nearDist then
                    nearDist = d
                    nearest = crate
                end
            end
        end
    end
    if nearest then
        hrp.CFrame = CFrame.new(nearest.Position + Vector3.new(0, 4, 0))
        Notify("Teleported to nearest crate!", GREEN)
    else
        Notify("No crates found", ORANGE)
    end
end)

