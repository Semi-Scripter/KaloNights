-- GitHub Raw URL for auto-updating
local GITHUB_RAW_URL = "https://raw.githubusercontent.com/YOUR_USERNAME/YOUR_REPO/main/script.lua"

-- Auto-update loader (Studio Plugin use)
local function loadLatestScript()
    local success, result = pcall(function()
        local code = HttpService:GetAsync(GITHUB_RAW_URL)
        local fn, err = loadstring(code)
        if fn then
            fn()
        else
            warn("loadstring error: " .. tostring(err))
        end
    end)
    if not success then
        warn("Auto-update failed: " .. tostring(result))
    end
end

