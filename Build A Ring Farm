-- Fly
makeSectionLabel("Fly (WASD + Space / Shift)", C_P2, PlrInner, 30)

local flyOn,flyConn,flyBV,flyBG = false,nil,nil,nil
local FlyBtn = makeBigBtn("Fly: OFF", C_P1, PlrInner, 31)

local function stopFly()
    flyOn = false; FlyBtn.Text = "Fly: OFF"; FlyBtn.BackgroundColor3 = C_P1
    if flyConn  then flyConn:Disconnect();  flyConn  = nil end
    if flyBV    then flyBV:Destroy();       flyBV    = nil end
    if flyBG    then flyBG:Destroy();       flyBG    = nil end
    local h = getHuman(); if h then h.PlatformStand = false end
end

FlyBtn.MouseButton1Click:Connect(function()
    flyOn = not flyOn
    if not flyOn then stopFly(); setPlr("Fly OFF",false); return end

    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then flyOn=false; return end

    FlyBtn.Text = "Fly: ON"; FlyBtn.BackgroundColor3 = C_P2

    flyBV = Instance.new("BodyVelocity",root)
    flyBV.MaxForce = Vector3.new(1e6,1e6,1e6); flyBV.Velocity = Vector3.zero

    flyBG = Instance.new("BodyGyro",root)
    flyBG.MaxTorque = Vector3.new(1e6,1e6,1e6); flyBG.P = 1e4

    local FLY_SPEED = 42

    flyConn = RunService.RenderStepped:Connect(function()
        local r2 = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not r2 or not flyBV or not flyBV.Parent then stopFly(); return end
        local cam = workspace.CurrentCamera
        local vel = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then vel = vel + cam.CFrame.LookVector  * FLY_SPEED end
        if UIS:IsKeyDown(Enum.KeyCode.S) then vel = vel - cam.CFrame.LookVector  * FLY_SPEED end
        if UIS:IsKeyDown(Enum.KeyCode.A) then vel = vel - cam.CFrame.RightVector * FLY_SPEED end
        if UIS:IsKeyDown(Enum.KeyCode.D) then vel = vel + cam.CFrame.RightVector * FLY_SPEED end
        if UIS:IsKeyDown(Enum.KeyCode.Space)     then vel = vel + Vector3.new(0,FLY_SPEED,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then vel = vel - Vector3.new(0,FLY_SPEED,0) end
        flyBV.Velocity  = vel
        flyBG.CFrame    = cam.CFrame
        local h2 = LP.Character:FindFirstChildWhichIsA("Humanoid")
        if h2 then h2.PlatformStand = (vel.Magnitude > 0.5) end
    end)

    setPlr("Fly ON — WASD + Space/Shift",true)
end)

