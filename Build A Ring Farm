-- Anti-Cheat Bypass (game has SpeedAntiCheatAdjuster + KnightmareAntiCheatDebug)
makeSectionLabel("Anti-Cheat Bypass", C_P3, PlrInner, 60)

local AC_PAT={
    "anticheat","anti_cheat","anti-cheat","speedanticheat","knightmareanticheat",
    "kicksystem","banhandler","exploitdetect","detection","sanitycheck",
    "speedcheck","flycheck","noclipcheck","fairplay","safeguard","guardian",
    "cheatdetect","hackdetect","securitycheck","antiexploit","exploitban",
    "cheatdetector","speedadjust"
}
local AC_EXACT={
    "SpeedAntiCheatAdjuster","KnightmareAntiCheatDebug","Downed","Ragdoll"
}
local acOn,acKilled=false,0
local AcBtn=makeBigBtn("Anti-Cheat Bypass: OFF",C_P3,PlrInner,61)

local function nameIsAC(nm)
    local lo=nm:lower()
    for _,p in ipairs(AC_PAT) do if lo:find(p,1,true) then return true end end
    for _,e in ipairs(AC_EXACT) do if nm==e then return true end end
    return false
end
local function deepAC(root,found,d)
    if d>8 then return end
    local ok,kids=pcall(function() return root:GetChildren() end)
    if not ok then return end
    for _,c in ipairs(kids) do
        local a,nm=pcall(function() return c.Name end)
        local b,cn=pcall(function() return c.ClassName end)
        if a and b then
            if nameIsAC(nm) then table.insert(found,c) end
            if cn=="Folder" or cn=="Model" or cn=="Configuration" then deepAC(c,found,d+1) end
        end
    end
end
local function runAC()
    local found={}
    for _,n in ipairs({"Workspace","ReplicatedStorage","StarterGui","ReplicatedFirst","StarterPack","StarterPlayer"}) do
        local s=safeGet(n); if s then deepAC(s,found,0) end
    end
    -- also target by exact name in workspace
    local ws=safeGet("Workspace")
    if ws then
        for _,nm in ipairs(AC_EXACT) do
            local sc=ws:FindFirstChild(nm,true)
            if sc and not table.find(found,sc) then table.insert(found,sc) end
        end
    end
    local k=0
    for _,inst in ipairs(found) do
        pcall(function()
            if inst:IsA("BaseScript") then inst.Disabled=true end
            inst:Destroy(); k=k+1; acKilled=acKilled+1
        end)
    end
    if k>0 then setPlr("AC: removed "..k.." this pass ("..acKilled.." total)",true) end
end
local function setAC(on)
    acOn=on
    if on then
        AcBtn.Text="Anti-Cheat Bypass: ON"; AcBtn.BackgroundColor3=C_P2
        setPlr("AC Bypass ON — scanning every 2s",true)
        task.spawn(runAC)
        task.spawn(function() while acOn do task.wait(2); if acOn then runAC() end end end)
    else
        AcBtn.Text="Anti-Cheat Bypass: OFF"; AcBtn.BackgroundColor3=C_P3
        setPlr("AC Bypass OFF — "..acKilled.." removed total",false)
    end
end
AcBtn.MouseButton1Click:Connect(function() setAC(not acOn) end)

