-- ── UTIL ─────────────────────────────────────────────────────
local function safeGet(n)
    local ok,r = pcall(game.GetService,game,n)
    if ok and r then return r end
    ok,r = pcall(function() return game[n] end)
    return ok and r or nil
end

local function getRemote(name)
    local RS = safeGet("ReplicatedStorage")
    return RS and RS:FindFirstChild(name,true) or nil
end

local function cloneToPlayer(item)
    local clone = item:Clone()
    if clone:IsA("Tool") then
        clone.Parent = LP.Backpack
        return
    end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        clone.Parent = workspace
        local cf = root.CFrame * CFrame.new(0,3,-5)
        if clone:IsA("Model") then
            if clone.PrimaryPart then
                clone:SetPrimaryPartCFrame(cf)
            else
                for _,p in ipairs(clone:GetDescendants()) do
                    if p:IsA("BasePart") then p.CFrame=cf; break end
                end
            end
        elseif clone:IsA("BasePart") then
            clone.CFrame = cf
        end
    else
        clone.Parent = LP.Backpack
    end
end

