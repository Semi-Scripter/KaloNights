-- // GOD MODE SCRIPT — Loadstring Compatible
-- // Client + Server-side validation with GUI toggle
-- // Place as a LocalScript or run via loadstring()

local Players        = game:GetService("Players")
local RunService     = game:GetService("RunService")
local TweenService   = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui")

local GodEnabled  = false
local Connections = {}
local ShieldBill  = nil

-- ============================================================
-- SERVER REMOTE SETUP
-- Attempts to register a RemoteFunction so the server
-- validates and applies a real ForceField + health lock.
-- Works when you have executor access to inject server code.
-- If the remote already exists (e.g. another loader created it)
-- we reuse it safely.
-- ============================================================
local GodRemote
local remoteFolder = ReplicatedStorage:FindFirstChild("_GodValidation")

if not remoteFolder then
    remoteFolder = Instance.new("Folder")
    remoteFolder.Name = "_GodValidation"
    remoteFolder.Parent = ReplicatedStorage
end

GodRemote = remoteFolder:FindFirstChild("GodToggle")
if not GodRemote then
    GodRemote = Instance.new("RemoteFunction")
    GodRemote.Name = "GodToggle"
    GodRemote.Parent = remoteFolder
end

-- Server-side handler (runs once inside pcall so it never errors)
pcall(function()
    local function applyServerSide(player, state)
        local char = player.Character
        if not char then return false end

        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid then return false end

        if state then
            -- Add a real ForceField (server-authoritative)
            if not char:FindFirstChildOfClass("ForceField") then
                local ff      = Instance.new("ForceField")
                ff.Visible    = false
                ff.Parent     = char
            end

            -- Lock max health on the server
            humanoid.MaxHealth = math.huge
            humanoid.Health    = math.huge

            -- Continuously restore health server-side
            if not char:FindFirstChild("_GodHB") then
                local tag = Instance.new("BoolValue")
                tag.Name  = "_GodHB"
                tag.Parent = char

                task.spawn(function()
                    while char and char:FindFirstChild("_GodHB") do
                        if humanoid and humanoid.Parent then
                            humanoid.MaxHealth = math.huge
                            humanoid.Health    = math.huge

                            local state_ = humanoid:GetState()
                            if state_ == Enum.HumanoidStateType.Dead then
                                humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                            end
                        end
                        task.wait(0.03)
                    end
                end)
            end
        else
            -- Disable: remove FF and restore defaults
            local ff = char:FindFirstChildOfClass("ForceField")
            if ff then ff:Destroy() end

            local tag = char:FindFirstChild("_GodHB")
            if tag then tag:Destroy() end

            humanoid.MaxHealth = 100
            humanoid.Health    = 100
        end

        return true
    end

    GodRemote.OnServerInvoke = applyServerSide
end)

