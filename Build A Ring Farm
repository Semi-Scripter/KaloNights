local function createShield(character)
    if ShieldBill then ShieldBill:Destroy() end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    ShieldBill          = Instance.new("BillboardGui")
    ShieldBill.Size     = UDim2.new(0, 55, 0, 55)
    ShieldBill.StudsOffset = Vector3.new(0, 3.5, 0)
    ShieldBill.Adornee  = root
    ShieldBill.Parent   = root
    local lbl = Instance.new("TextLabel")
    lbl.Size                   = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text                   = "🛡"
    lbl.TextScaled             = true
    lbl.Parent                 = ShieldBill
end

local function removeShield()
    if ShieldBill then ShieldBill:Destroy(); ShieldBill = nil end
end

-- ================================================================
-- DISCONNECT HELPERS
-- ================================================================
local function disconnectList(list)
    for _, c in ipairs(list) do
        pcall(function()
            if c and c.Connected then c:Disconnect() end
        end)
    end
end

-- ================================================================
-- PER-CHARACTER GOD APPLICATION
-- ================================================================
local function applyClientGod(character)
    if not character then return end
    local hum = character:WaitForChild("Humanoid", 5)
    if not hum then return end

    -- 1. Block Dead state — humanoid literally cannot die
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        hum.BreakJointsOnDeath = false
    end)

    -- 2. Max health
    hum.MaxHealth = math.huge
    hum.Health    = math.huge

    -- 3. GetPropertyChangedSignal — fires the instant Health changes,
    --    faster than HealthChanged event in most executors
    Connections[#Connections+1] = hum:GetPropertyChangedSignal("Health"):Connect(function()
        if GodEnabled and hum and hum.Parent then
            if hum.Health < math.huge then
                hum.Health = math.huge
            end
        end
    end)

    -- 4. HealthChanged as backup
    Connections[#Connections+1] = hum.HealthChanged:Connect(function(hp)
        if GodEnabled and hp < math.huge and hum.Parent then
            hum.Health = math.huge
        end
    end)

    -- 5. Died — catch any death that slips through and immediately undo it
    Connections[#Connections+1] = hum.Died:Connect(function()
        if not GodEnabled then return end
        task.defer(function()
            if hum and hum.Parent then
                pcall(function()
                    hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                    hum.MaxHealth = math.huge
                    hum.Health    = math.huge
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end)
            end
        end)
    end)

    -- 6. Tight spin loop — task.wait() = ~1 frame, much faster than Heartbeat
    task.spawn(function()
        while GodEnabled do
            if hum and hum.Parent then
                pcall(function()
                    hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                    if hum.MaxHealth < math.huge then hum.MaxHealth = math.huge end
                    if hum.Health    < math.huge then hum.Health    = math.huge end
                    if hum:GetState() == Enum.HumanoidStateType.Dead then
                        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                    end
                end)
            end
            task.wait()
        end
    end)

    -- 7. Heartbeat — one more safety net
    Connections[#Connections+1] = RunService.Heartbeat:Connect(function()
        if not GodEnabled or not hum or not hum.Parent then return end
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            hum.MaxHealth = math.huge
            hum.Health    = math.huge
        end)
    end)

    -- 8. Body-part Touched — pin health the moment anything touches us
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            Connections[#Connections+1] = part.Touched:Connect(function()
                if GodEnabled and hum and hum.Parent then
                    pcall(function()
                        hum.MaxHealth = math.huge
                        hum.Health    = math.huge
                    end)
                end
            end)
        end
    end

    -- 9. ForceField (server call)
    pcall(function() GodRemote:InvokeServer(true) end)

    createShield(character)
end

-- ================================================================
-- ANTI-CHEAT BYPASS
-- ================================================================
local ANTI_PREFIXES = { "anti", "exploit", "security" }
local function isAnti(name)
    local l = name:lower()
    for _, p in ipairs(ANTI_PREFIXES) do
        if l:sub(1, #p) == p then return true end
    end
    return false
end

local SCAN_SERVICES = {
    "Workspace","ReplicatedStorage","ReplicatedFirst",
    "StarterGui","StarterPack","StarterPlayer",
    "Lighting","Teams","SoundService","Players"
}

local function nukeObj(obj)
    pcall(function()
        if obj:IsA("BaseScript") or obj:IsA("ModuleScript") then
            obj.Disabled = true
        end
        obj:Destroy()
    end)
end

local function scanService(svcName)
    local ok, svc = pcall(function() return game:GetService(svcName) end)
    if not ok then return end
    pcall(function()
        for _, obj in ipairs(svc:GetDescendants()) do
            if isAnti(obj.Name) then nukeObj(obj) end
        end
    end)
    local conn = svc.DescendantAdded:Connect(function(obj)
        if AntiEnabled and isAnti(obj.Name) then task.defer(nukeObj, obj) end
    end)
    AntiConns[#AntiConns+1] = conn
end

local function enableAnti()
    AntiEnabled = true
    AntiBtn.Text = "Anti: ON ✓"
    TweenService:Create(AntiBtn, TweenInfo.new(0.25), {
        BackgroundColor3 = Color3.fromRGB(200, 130, 15)
    }):Play()
    pcall(function() scanService("Players"); scanService("Workspace") end)
    for _, s in ipairs(SCAN_SERVICES) do scanService(s) end
    pcall(function()
        for _, obj in ipairs(LocalPlayer:GetDescendants()) do
            if isAnti(obj.Name) then nukeObj(obj) end
        end
    end)
    task.spawn(function()
        while AntiEnabled do
            task.wait(2)
            if not AntiEnabled then break end
            for _, s in ipairs(SCAN_SERVICES) do
                pcall(function()
                    local svc = game:GetService(s)
                    for _, obj in ipairs(svc:GetDescendants()) do
                        if isAnti(obj.Name) then nukeObj(obj) end
                    end
                end)
            end
        end
    end)
end

local function disableAnti()
    AntiEnabled = false
    disconnectList(AntiConns); AntiConns = {}
    AntiBtn.Text = "Anti: OFF"
    TweenService:Create(AntiBtn, TweenInfo.new(0.25), {
        BackgroundColor3 = Color3.fromRGB(130, 80, 10)
    }):Play()
end

-- ================================================================
-- ENABLE / DISABLE GOD
-- ================================================================
local function enableGod()
    GodEnabled = true
    StatusLabel.Text       = "Status: ON  ✓"
    StatusLabel.TextColor3 = Color3.fromRGB(60, 230, 110)
    GodBtn.Text            = "Disable God"
    TweenService:Create(GodBtn,  TweenInfo.new(0.25), { BackgroundColor3 = Color3.fromRGB(35, 185, 75) }):Play()
    TweenService:Create(Stroke,  TweenInfo.new(0.25), { Color = Color3.fromRGB(60, 230, 110) }):Play()

    local char = LocalPlayer.Character
    if char then applyClientGod(char) end

    Connections[#Connections+1] = LocalPlayer.CharacterAdded:Connect(function(newChar)
        if GodEnabled then task.wait(0.5); applyClientGod(newChar) end
    end)
end

local function disableGod()
    GodEnabled = false
    disconnectList(Connections); Connections = {}
    removeShield()
    StatusLabel.Text       = "Status: OFF"
    StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
    GodBtn.Text            = "Enable God"
    TweenService:Create(GodBtn,  TweenInfo.new(0.25), { BackgroundColor3 = Color3.fromRGB(220, 55, 55) }):Play()
    TweenService:Create(Stroke,  TweenInfo.new(0.25), { Color = Color3.fromRGB(70, 70, 210) }):Play()

    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.MaxHealth = 100; hum.Health = 100 end
        local ff = char:FindFirstChildOfClass("ForceField")
        if ff then ff:Destroy() end
    end
    pcall(function() GodRemote:InvokeServer(false) end)
end

