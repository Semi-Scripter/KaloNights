local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ── Remote setup ─────────────────────────────────────────────
local folder = ReplicatedStorage:FindFirstChild("_TurretSystem")
if not folder then
    folder        = Instance.new("Folder")
    folder.Name   = "_TurretSystem"
    folder.Parent = ReplicatedStorage
end

local function getOrCreate(class, name, parent)
    return parent:FindFirstChild(name) or (function()
        local r       = Instance.new(class)
        r.Name        = name
        r.Parent      = parent
        return r
    end)()
end

local ToggleEvent  = getOrCreate("RemoteEvent",    "TurretToggle",   folder)
local DisableEvent = getOrCreate("RemoteEvent",    "DisableAttack",  folder)

-- ── Config ───────────────────────────────────────────────────
local PART_COUNT   = 10
local ORBIT_RADIUS = 3
local ORBIT_HEIGHT = 5
local SCAN_RANGE   = 60
local FIRE_RATE    = 0.4
local DAMAGE_MIN   = 20
local DAMAGE_MAX   = 30

-- Scripts to destroy when the player clicks "Disable Zombie Damage"
-- Add or remove names to match your game exactly
local DAMAGE_SCRIPT_NAMES = {
    "AttackScript",
    "MobAI",
    "WalkAnimator",
    "RagdollHandler",
    "HealthbarScript",
}

local activeTurrets = {}

-- ── Find nearest enemy ────────────────────────────────────────
local function findNearestEnemy(rootPos, playerChar)
    local nearest, nearestDist = nil, SCAN_RANGE
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Health > 0 then
            local char = obj.Parent
            if char ~= playerChar then
                local root = char:FindFirstChild("HumanoidRootPart")
                    or char:FindFirstChild("Torso")
                    or char:FindFirstChildOfClass("BasePart")
                if root then
                    local dist = (root.Position - rootPos).Magnitude
                    if dist < nearestDist then
                        nearest     = obj
                        nearestDist = dist
                    end
                end
            end
        end
    end
    return nearest
end

-- ── Fire one bullet ──────────────────────────────────────────
local function fireProjectile(fromPart, targetHum)
    local targetChar = targetHum.Parent
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        or targetChar:FindFirstChild("Torso")
        or targetChar:FindFirstChildOfClass("BasePart")
    if not targetRoot then return end

    local bullet          = Instance.new("Part")
    bullet.Size           = Vector3.new(0.2, 0.2, 0.2)
    bullet.Shape          = Enum.PartType.Ball
    bullet.BrickColor     = BrickColor.new("Bright yellow")
    bullet.Material       = Enum.Material.Neon
    bullet.CastShadow     = false
    bullet.CanCollide     = false
    bullet.Anchored       = true
    bullet.Position       = fromPart.Position
    bullet.Parent         = workspace

    local startPos   = fromPart.Position
    local endPos     = targetRoot.Position
    local travelTime = (endPos - startPos).Magnitude / 120
    local steps      = math.max(1, math.floor(travelTime / 0.01))

    task.spawn(function()
        for i = 1, steps do
            if not bullet.Parent then break end
            bullet.Position = startPos:Lerp(endPos, i / steps)
            task.wait(0.01)
        end
        bullet:Destroy()
        if targetHum and targetHum.Parent and targetHum.Health > 0 then
            targetHum:TakeDamage(math.random(DAMAGE_MIN, DAMAGE_MAX))
        end
    end)
end

-- ── Activate turret ──────────────────────────────────────────
local function activateTurret(player)
    if activeTurrets[player] then return end
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local parts, connections = {}, {}

    for i = 1, PART_COUNT do
        local p           = Instance.new("Part")
        p.Size            = Vector3.new(0.5, 0.5, 0.5)
        p.Shape           = Enum.PartType.Ball
        p.BrickColor      = BrickColor.new("Cyan")
        p.Material        = Enum.Material.Neon
        p.CastShadow      = false
        p.CanCollide      = false
        p.Anchored        = true
        p.Parent          = workspace
        parts[i]          = p
    end

    activeTurrets[player] = { parts = parts, connections = connections }

    local angle = 0
    connections[#connections+1] = RunService.Heartbeat:Connect(function(dt)
        local c = player.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if not r then return end
        angle = angle + dt * 1.8
        for i, p in ipairs(parts) do
            local a = angle + (i - 1) * (2 * math.pi / PART_COUNT)
            p.Position = Vector3.new(
                r.Position.X + math.cos(a) * ORBIT_RADIUS,
                r.Position.Y + ORBIT_HEIGHT,
                r.Position.Z + math.sin(a) * ORBIT_RADIUS
            )
        end
    end)

    task.spawn(function()
        local idx = 1
        while activeTurrets[player] do
            local c = player.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if r then
                local enemy = findNearestEnemy(r.Position, c)
                if enemy then
                    local p = parts[idx]
                    if p and p.Parent then fireProjectile(p, enemy) end
                    idx = (idx % PART_COUNT) + 1
                end
            end
            task.wait(FIRE_RATE)
        end
    end)
end

-- ── Deactivate turret ─────────────────────────────────────────
local function deactivateTurret(player)
    local data = activeTurrets[player]
    if not data then return end
    for _, p in ipairs(data.parts) do pcall(function() p:Destroy() end) end
    for _, c in ipairs(data.connections) do
        pcall(function() if c.Connected then c:Disconnect() end end)
    end
    activeTurrets[player] = nil
end

-- ── Disable zombie damage scripts ────────────────────────────
DisableEvent.OnServerEvent:Connect(function(player)
    local destroyed = 0
    -- Search Workspace and all descendants
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript")) then
            for _, scriptName in ipairs(DAMAGE_SCRIPT_NAMES) do
                if obj.Name == scriptName then
                    pcall(function()
                        obj.Disabled = true   -- disable first
                        obj:Destroy()         -- then remove
                        destroyed = destroyed + 1
                    end)
                    break
                end
            end
        end
    end
    print("[TurretServer] Disabled " .. destroyed .. " damage script(s) for " .. player.Name)
end)

-- ── Remote listeners ─────────────────────────────────────────
ToggleEvent.OnServerEvent:Connect(function(player, state)
    if state then activateTurret(player) else deactivateTurret(player) end
end)

Players.PlayerRemoving:Connect(deactivateTurret)

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        if activeTurrets[player] then
            deactivateTurret(player)
            task.wait(1)
            activateTurret(player)
        end
    end)
end)


