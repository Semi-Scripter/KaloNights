local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ── Remote folder ─────────────────────────────────────────────
local folder = ReplicatedStorage:FindFirstChild("_AdminMenu")
if not folder then
    folder        = Instance.new("Folder")
    folder.Name   = "_AdminMenu"
    folder.Parent = ReplicatedStorage
end

local function remote(class, name)
    local r = folder:FindFirstChild(name)
    if not r then
        r        = Instance.new(class)
        r.Name   = name
        r.Parent = folder
    end
    return r
end

local GodEvent      = remote("RemoteEvent",    "GodToggle")
local TurretEvent   = remote("RemoteEvent",    "TurretToggle")
local DisableEvent  = remote("RemoteEvent",    "DisableAttack")
local KillAllEvent  = remote("RemoteEvent",    "KillAll")
local FreezeEvent   = remote("RemoteEvent",    "FreezeAll")

-- ── Config ────────────────────────────────────────────────────
local ORBIT_RADIUS  = 3
local ORBIT_HEIGHT  = 5
local SCAN_RANGE    = 65
local FIRE_RATE     = 0.35
local DAMAGE_MIN    = 20
local DAMAGE_MAX    = 30
local PART_COUNT    = 10

-- Names of scripts to wipe when "Disable Damage" is pressed
local DAMAGE_SCRIPTS = {
    "AttackScript",
    "MobAI",
    "WalkAnimator",
    "RagdollHandler",
    "HealthbarScript",
    "DamageScript",
    "ZombieDamage",
    "EnemyAttack",
}

local activeTurrets = {}

-- ── Helpers ───────────────────────────────────────────────────
local function findNearestEnemy(rootPos, playerChar)
    local best, bestDist = nil, SCAN_RANGE
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Health > 0 and obj.Parent ~= playerChar then
            local root = obj.Parent:FindFirstChild("HumanoidRootPart")
                or obj.Parent:FindFirstChild("Torso")
                or obj.Parent:FindFirstChildOfClass("BasePart")
            if root then
                local d = (root.Position - rootPos).Magnitude
                if d < bestDist then best, bestDist = obj, d end
            end
        end
    end
    return best
end

local function fireProjectile(fromPart, targetHum)
    local tRoot = targetHum.Parent:FindFirstChild("HumanoidRootPart")
        or targetHum.Parent:FindFirstChild("Torso")
        or targetHum.Parent:FindFirstChildOfClass("BasePart")
    if not tRoot then return end

    local b           = Instance.new("Part")
    b.Size            = Vector3.new(0.18, 0.18, 0.18)
    b.Shape           = Enum.PartType.Ball
    b.Color           = Color3.fromRGB(255, 220, 0)
    b.Material        = Enum.Material.Neon
    b.CastShadow      = false
    b.CanCollide      = false
    b.Anchored        = true
    b.Position        = fromPart.Position
    b.Parent          = workspace

    local s = fromPart.Position
    local e = tRoot.Position
    local steps = math.max(1, math.floor((e - s).Magnitude / 120 / 0.01))

    task.spawn(function()
        for i = 1, steps do
            if not b.Parent then break end
            b.Position = s:Lerp(e, i / steps)
            task.wait(0.01)
        end
        b:Destroy()
        if targetHum and targetHum.Parent and targetHum.Health > 0 then
            targetHum:TakeDamage(math.random(DAMAGE_MIN, DAMAGE_MAX))
        end
    end)
end

-- ── God Mode ──────────────────────────────────────────────────
GodEvent.OnServerEvent:Connect(function(player, state)
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if state then
        if not char:FindFirstChildOfClass("ForceField") then
            local ff         = Instance.new("ForceField")
            ff.Visible       = false
            ff.Parent        = char
        end
        hum.MaxHealth = math.huge
        hum.Health    = math.huge

        if not char:FindFirstChild("_GodTag") then
            local tag        = Instance.new("BoolValue")
            tag.Name         = "_GodTag"
            tag.Parent       = char
            task.spawn(function()
                while char:FindFirstChild("_GodTag") do
                    if hum and hum.Parent then
                        hum.MaxHealth = math.huge
                        hum.Health    = math.huge
                        pcall(function()
                            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                        end)
                    end
                    task.wait(0.05)
                end
            end)
        end
    else
        local ff  = char:FindFirstChildOfClass("ForceField")
        if ff  then ff:Destroy() end
        local tag = char:FindFirstChild("_GodTag")
        if tag then tag:Destroy() end
        hum.MaxHealth = 100
        hum.Health    = 100
    end
end)

-- ── Turret ────────────────────────────────────────────────────
local function activateTurret(player)
    if activeTurrets[player] then return end
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local parts, conns = {}, {}

    for i = 1, PART_COUNT do
        local p          = Instance.new("Part")
        p.Size           = Vector3.new(0.5, 0.5, 0.5)
        p.Shape          = Enum.PartType.Ball
        p.Color          = Color3.fromRGB(0, 220, 255)
        p.Material       = Enum.Material.Neon
        p.CastShadow     = false
        p.CanCollide     = false
        p.Anchored       = true
        p.Parent         = workspace
        parts[i]         = p
    end

    activeTurrets[player] = { parts = parts, conns = conns }

    local angle = 0
    conns[#conns+1] = RunService.Heartbeat:Connect(function(dt)
        local c = player.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if not r then return end
        angle = angle + dt * 1.8
        for i, p in ipairs(parts) do
            local a = angle + (i - 1) * (2 * math.pi / PART_COUNT)
            p.Position = Vector3.new(
                r.Position.X + math.cos(a) * ORBIT_RADIUS,
                r.Position.Y + ORBIT_HEIGHT,
                r.Position.Z + math.sin(a) * ORBIT_RADIUS
            )
        end
    end)

    task.spawn(function()
        local idx = 1
        while activeTurrets[player] do
            local c = player.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if r then
                local enemy = findNearestEnemy(r.Position, c)
                if enemy then
                    local p = parts[idx]
                    if p and p.Parent then fireProjectile(p, enemy) end
                    idx = (idx % PART_COUNT) + 1
                end
            end
            task.wait(FIRE_RATE)
        end
    end)
end

local function deactivateTurret(player)
    local data = activeTurrets[player]
    if not data then return end
    for _, p in ipairs(data.parts) do pcall(function() p:Destroy() end) end
    for _, c in ipairs(data.conns) do
        pcall(function() if c.Connected then c:Disconnect() end end)
    end
    activeTurrets[player] = nil
end

TurretEvent.OnServerEvent:Connect(function(player, state)
    if state then activateTurret(player) else deactivateTurret(player) end
end)

-- ── Disable damage scripts ────────────────────────────────────
DisableEvent.OnServerEvent:Connect(function(player)
    local destroyed = 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
            for _, name in ipairs(DAMAGE_SCRIPTS) do
                if obj.Name == name then
                    pcall(function()
                        obj.Disabled = true
                        obj:Destroy()
                        destroyed += 1
                    end)
                    break
                end
            end
        end
    end
    print("[AdminMenu] " .. player.Name .. " wiped " .. destroyed .. " damage script(s)")
end)

-- ── Kill All nearby enemies ───────────────────────────────────
KillAllEvent.OnServerEvent:Connect(function(player)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Health > 0 and obj.Parent ~= char then
            local r = obj.Parent:FindFirstChild("HumanoidRootPart")
                or obj.Parent:FindFirstChild("Torso")
                or obj.Parent:FindFirstChildOfClass("BasePart")
            if r and (r.Position - root.Position).Magnitude <= 80 then
                pcall(function() obj.Health = 0 end)
            end
        end
    end
end)

-- ── Freeze All nearby enemies ─────────────────────────────────
local frozenParts = {}

FreezeEvent.OnServerEvent:Connect(function(player, state)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if state then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Humanoid") and obj.Parent ~= char then
                local r = obj.Parent:FindFirstChild("HumanoidRootPart")
                if r and (r.Position - root.Position).Magnitude <= 80 then
                    pcall(function()
                        obj.WalkSpeed   = 0
                        obj.JumpPower   = 0
                        r.Anchored      = true
                        table.insert(frozenParts, r)
                    end)
                end
            end
        end
    else
        for _, r in ipairs(frozenParts) do
            pcall(function()
                r.Anchored = false
                local hum = r.Parent and r.Parent:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.WalkSpeed = 16
                    hum.JumpPower = 50
                end
            end)
        end
        frozenParts = {}
    end
end)

-- ── Cleanup on leave / respawn ────────────────────────────────
Players.PlayerRemoving:Connect(deactivateTurret)

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        if activeTurrets[player] then
            deactivateTurret(player)
            task.wait(1)
            activateTurret(player)
        end
    end)
end)


