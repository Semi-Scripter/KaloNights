-- ============================================================
--  DRAG LOGIC
-- ============================================================

local dragging = false
local dragInput, dragStart, startPos

TitleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

TitleBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

-- ============================================================
--  PICKUP LOGIC
-- ============================================================

local isActive    = false
local collected   = 0
local loopThread  = nil

local function setStatus(text, color)
	StatusLabel.Text = text
	StatusLabel.TextColor3 = color or Color3.fromRGB(160, 160, 160)
end

local function pickupLoop()
	while isActive do
		local DroppedItems = workspace:FindFirstChild("DroppedItems")
		if DroppedItems then
			local found = 0
			for _, item in ipairs(DroppedItems:GetChildren()) do
				if item:IsA("Model") and item.Name == "Emerald" then
					local primaryPart = item.PrimaryPart
						or item:FindFirstChildWhichIsA("BasePart")
					if primaryPart then
						PickUpItem:FireServer(item)
						collected += 1
						found += 1
						CounterLabel.Text = "Collected: " .. collected
					end
				end
			end
			if found > 0 then
				setStatus("Picked up " .. found .. " emerald(s)!", Color3.fromRGB(80, 220, 130))
			else
				setStatus("Scanning… (0 found)", Color3.fromRGB(160, 160, 160))
			end
		else
			setStatus("DroppedItems not found!", Color3.fromRGB(220, 80, 80))
		end
		task.wait(0.5)
	end
end

local function startPickup()
	isActive = true
	ToggleBtn.Text        = "⏹  EMERALDS  [ ON ]"
	ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	ToggleBtnStroke.Color = Color3.fromRGB(255, 100, 100)
	UIStroke.Color        = Color3.fromRGB(80, 220, 130)
	setStatus("Running…", Color3.fromRGB(80, 220, 130))
	loopThread = task.spawn(pickupLoop)
end

local function stopPickup()
	isActive = false
	if loopThread then task.cancel(loopThread) end
	ToggleBtn.Text        = "▶  EMERALDS  [ OFF ]"
	ToggleBtn.BackgroundColor3 = Color3.fromRGB(35, 120, 60)
	ToggleBtnStroke.Color = Color3.fromRGB(80, 200, 120)
	UIStroke.Color        = Color3.fromRGB(80, 200, 120)
	setStatus("Idle", Color3.fromRGB(160, 160, 160))
end

-- ============================================================
--  BUTTON EVENTS
