local Players           = game:GetService("Players")
local TweenService      = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui")

local folder       = ReplicatedStorage:WaitForChild("_TurretSystem", 15)
local ToggleEvent  = folder and folder:WaitForChild("TurretToggle",  10)
local DisableEvent = folder and folder:WaitForChild("DisableAttack", 10)

local turretOn      = false
local attackDisabled = false

-- ── Helper: corner radius ─────────────────────────────────────
local function addCorner(parent, radius)
    local c         = Instance.new("UICorner")
    c.CornerRadius  = UDim.new(0, radius or 10)
    c.Parent        = parent
end

local function addStroke(parent, color, thickness)
    local s       = Instance.new("UIStroke")
    s.Color       = color
    s.Thickness   = thickness or 1.5
    s.Parent      = parent
end

-- ── Build GUI ─────────────────────────────────────────────────
local old = PlayerGui:FindFirstChild("TurretUI")
if old then old:Destroy() end

local Gui               = Instance.new("ScreenGui")
Gui.Name                = "TurretUI"
Gui.ResetOnSpawn        = false
Gui.IgnoreGuiInset      = true
Gui.ZIndexBehavior      = Enum.ZIndexBehavior.Sibling
Gui.Parent              = PlayerGui

-- Panel frame
local Panel                   = Instance.new("Frame")
Panel.Size                    = UDim2.new(0, 200, 0, 110)
Panel.Position                = UDim2.new(0.5, -100, 0, 10)
Panel.BackgroundColor3        = Color3.fromRGB(14, 14, 22)
Panel.BorderSizePixel         = 0
Panel.Active                  = true
Panel.Draggable               = true
Panel.Parent                  = Gui
addCorner(Panel, 12)
addStroke(Panel, Color3.fromRGB(60, 60, 180), 1.5)

local Layout          = Instance.new("UIListLayout")
Layout.Padding        = UDim.new(0, 8)
Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
Layout.VerticalAlignment   = Enum.VerticalAlignment.Center
Layout.Parent         = Panel

local Padding         = Instance.new("UIPadding")
Padding.PaddingTop    = UDim.new(0, 10)
Padding.PaddingBottom = UDim.new(0, 10)
Padding.Parent        = Panel

-- ── Button factory ────────────────────────────────────────────
local function makeButton(text, bgColor, strokeColor)
    local b               = Instance.new("TextButton")
    b.Size                = UDim2.new(0.82, 0, 0, 38)
    b.BackgroundColor3    = bgColor
    b.BorderSizePixel     = 0
    b.Text                = text
    b.TextColor3          = Color3.fromRGB(230, 230, 255)
    b.TextSize            = 14
    b.Font                = Enum.Font.GothamBold
    b.AutoButtonColor     = false
    b.Parent              = Panel
    addCorner(b, 8)
    addStroke(b, strokeColor, 1.5)

    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.12), { Size = UDim2.new(0.86, 0, 0, 40) }):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.12), { Size = UDim2.new(0.82, 0, 0, 38) }):Play()
    end)
    return b
end

local TurretBtn  = makeButton("🔵  Turret: OFF",           Color3.fromRGB(25, 25, 45), Color3.fromRGB(60,  60, 180))
local DisableBtn = makeButton("🗡  Disable Zombie Damage", Color3.fromRGB(55, 15, 15), Color3.fromRGB(180, 40,  40))

-- ── Turret toggle ─────────────────────────────────────────────
TurretBtn.MouseButton1Click:Connect(function()
    if not ToggleEvent then return end
    turretOn = not turretOn
    ToggleEvent:FireServer(turretOn)

    if turretOn then
        TurretBtn.Text             = "🟡  Turret: ON"
        TurretBtn.BackgroundColor3 = Color3.fromRGB(20, 55, 20)
        TweenService:Create(TurretBtn, TweenInfo.new(0.2),
            { TextColor3 = Color3.fromRGB(120, 255, 120) }):Play()
        -- update stroke green
        local s = TurretBtn:FindFirstChildOfClass("UIStroke")
        if s then s.Color = Color3.fromRGB(60, 200, 60) end
    else
        TurretBtn.Text             = "🔵  Turret: OFF"
        TurretBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 45)
        TweenService:Create(TurretBtn, TweenInfo.new(0.2),
            { TextColor3 = Color3.fromRGB(230, 230, 255) }):Play()
        local s = TurretBtn:FindFirstChildOfClass("UIStroke")
        if s then s.Color = Color3.fromRGB(60, 60, 180) end
    end
end)

-- ── Disable zombie damage ─────────────────────────────────────
DisableBtn.MouseButton1Click:Connect(function()
    if not DisableEvent then return end
    if attackDisabled then return end  -- only let them press once
    attackDisabled = true

    DisableEvent:FireServer()

    DisableBtn.Text             = "✅  Damage Disabled"
    DisableBtn.BackgroundColor3 = Color3.fromRGB(15, 40, 15)
    DisableBtn.TextColor3       = Color3.fromRGB(100, 230, 100)
    local s = DisableBtn:FindFirstChildOfClass("UIStroke")
    if s then s.Color = Color3.fromRGB(60, 200, 60) end
end)
