    local oldNC
    oldNC = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        if godEnabled and getnamecallmethod() == "TakeDamage" then
            local hum = getHum()
            if hum and self == hum then return end
        end
        return oldNC(self, ...)
    end))
end)

