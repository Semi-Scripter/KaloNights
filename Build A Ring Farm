-- ============================================================
-- ADMIN LIST — add usernames or user IDs of authorized admins
-- ============================================================
local AdminList = {
    [LocalPlayer.Name] = true,  -- Always give yourself access
    -- ["BlademanJR1"]  = true,
    -- [123456789]       = true,  -- by UserId
}

local function IsAdmin(player)
    return AdminList[player.Name] == true or AdminList[player.UserId] == true
end

if not IsAdmin(LocalPlayer) then return end

