local PlayerTab = MakeTabPage("Player",  "👤")
local PS = MakeScrollFrame(PlayerTab)

MakeSectionLabel(PS, "MOVEMENT")

MakeSlider(PS, "Walk Speed", 1, 200, 16, function(v)
    local hum = GetHum()
    if hum then hum.WalkSpeed = v end
end)

MakeSlider(PS, "Jump Power", 1, 200, 50, function(v)
    local hum = GetHum()
    if hum then hum.JumpPower = v end
end)

MakeSlider(PS, "Fly Speed", 10, 200, 60, function(v)
    State.FlySpeed = v
end)

MakeSectionLabel(PS, "ABILITIES")

MakeToggle(PS, "God Mode (Infinite HP)", false, function(on)
    State.GodMode = on
    State.InfHealth = on
    local hum = GetHum()
    if on then
        Notify("God Mode ON", GREEN)
        if hum then hum.MaxHealth = math.huge; hum.Health = math.huge end
        State.GodConn = RunService.Heartbeat:Connect(function()
            local h = GetHum()
            if h then
                h.MaxHealth = math.huge
                h.Health    = math.huge
            end
        end)
    else
        Notify("God Mode OFF", ORANGE)
        if State.GodConn then State.GodConn:Disconnect(); State.GodConn = nil end
        local h = GetHum()
        if h then h.MaxHealth = 100; h.Health = 100 end
    end
end)

MakeToggle(PS, "Noclip", false, function(on)
    State.Noclip = on
    if on then
        Notify("Noclip ON", GREEN)
        State.NoclipConn = RunService.Stepped:Connect(function()
            local char = GetChar()
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        Notify("Noclip OFF", ORANGE)
        if State.NoclipConn then State.NoclipConn:Disconnect(); State.NoclipConn = nil end
        local char = GetChar()
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end)

MakeToggle(PS, "Fly Mode", false, function(on)
    State.Fly = on
    local hrp = GetHRP()
    if on then
        Notify("Fly ON — WASD + Space/Ctrl", GREEN)
        if hrp then
            local bv = Instance.new("BodyVelocity")
            bv.Velocity   = Vector3.zero
            bv.MaxForce   = Vector3.new(1e5, 1e5, 1e5)
            bv.Parent     = hrp
            State.FlyBodyVel = bv

            local bg = Instance.new("BodyGyro")
            bg.MaxTorque  = Vector3.new(1e5, 1e5, 1e5)
            bg.D          = 50
            bg.Parent     = hrp
            State.FlyBodyGyro = bg
        end
        State.FlyConn = RunService.Heartbeat:Connect(function()
            local hrp2 = GetHRP()
            if not hrp2 or not State.FlyBodyVel then return end
            local cam = workspace.CurrentCamera
            local dir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space)      then dir = dir + Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0,1,0) end
            State.FlyBodyVel.Velocity = dir.Magnitude > 0 and dir.Unit * State.FlySpeed or Vector3.zero
            if State.FlyBodyGyro then
                State.FlyBodyGyro.CFrame = cam.CFrame
            end
        end)
    else
        Notify("Fly OFF", ORANGE)
        if State.FlyConn then State.FlyConn:Disconnect(); State.FlyConn = nil end
        if State.FlyBodyVel  then State.FlyBodyVel:Destroy();  State.FlyBodyVel  = nil end
        if State.FlyBodyGyro then State.FlyBodyGyro:Destroy(); State.FlyBodyGyro = nil end
    end
end)

