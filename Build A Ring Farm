-- ── Toggle button helper ──────────────────────────────────────
local function makeToggleBtn(textOff, textOn, offBg, onBg, offStroke, onStroke, order)
    local btn                   = Instance.new("TextButton")
    btn.Size                    = UDim2.new(0.88, 0, 0, 42)
    btn.BackgroundColor3        = offBg
    btn.BorderSizePixel         = 0
    btn.Text                    = textOff
    btn.TextColor3              = C.text
    btn.TextSize                = 14
    btn.Font                    = Enum.Font.GothamBold
    btn.AutoButtonColor         = false
    btn.LayoutOrder             = order
    btn.Parent                  = Body
    corner(btn, 8)
    stroke(btn, offStroke, 1.5)

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), { Size = UDim2.new(0.92, 0, 0, 44) }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), { Size = UDim2.new(0.88, 0, 0, 42) }):Play()
    end)

    local active = false
    local s = btn:FindFirstChildOfClass("UIStroke")

    local function setVisual(on)
        btn.Text             = on and textOn  or textOff
        btn.BackgroundColor3 = on and onBg    or offBg
        if s then s.Color   = on and onStroke or offStroke end
        TweenService:Create(btn, TweenInfo.new(0.15),
            { TextColor3 = on and C.green or C.text }):Play()
    end

    return btn, function() return active end, function(state)
        active = state
        setVisual(active)
    end
end

