local function MakeButton(parent, text, callback, color)
    local btn = Instance.new("TextButton")
    btn.Size             = UDim2.new(1, 0, 0, 30)
    btn.BackgroundColor3 = color or BG_LIGHT
    btn.BorderSizePixel  = 0
    btn.Text             = text
    btn.TextColor3       = TEXT_COL
    btn.Font             = Enum.Font.GothamMedium
    btn.TextSize         = 12
    btn.AutoButtonColor  = false
    btn.Parent           = parent
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    btn.MouseEnter:Connect(function()
        Tween(btn, {BackgroundColor3 = color and color:Lerp(Color3.new(1,1,1), 0.15) or BG_LIGHT:Lerp(Color3.new(1,1,1), 0.12)})
    end)
    btn.MouseLeave:Connect(function()
        Tween(btn, {BackgroundColor3 = color or BG_LIGHT})
    end)
    btn.MouseButton1Click:Connect(function()
        if callback then callback() end
    end)
    return btn
end

local function MakeToggle(parent, text, default, onToggle)
    local frame = Instance.new("Frame")
    frame.Size             = UDim2.new(1, 0, 0, 30)
    frame.BackgroundColor3 = BG_LIGHT
    frame.BorderSizePixel  = 0
    frame.Parent           = parent
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local lbl = Instance.new("TextLabel")
    lbl.Size               = UDim2.new(1, -55, 1, 0)
    lbl.Position           = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text               = text
    lbl.TextColor3         = TEXT_COL
    lbl.Font               = Enum.Font.GothamMedium
    lbl.TextSize           = 12
    lbl.TextXAlignment     = Enum.TextXAlignment.Left
    lbl.Parent             = frame

    local knobBg = Instance.new("Frame")
    knobBg.Size             = UDim2.new(0, 38, 0, 20)
    knobBg.Position         = UDim2.new(1, -48, 0.5, -10)
    knobBg.BackgroundColor3 = default and GREEN or Color3.fromRGB(80, 80, 90)
    knobBg.BorderSizePixel  = 0
    knobBg.Parent           = frame
    local kbg = Instance.new("UICorner")
    kbg.CornerRadius = UDim.new(1, 0)
    kbg.Parent = knobBg

    local knob = Instance.new("Frame")
    knob.Size             = UDim2.new(0, 14, 0, 14)
    knob.Position         = default and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel  = 0
    knob.Parent           = knobBg
    local kc = Instance.new("UICorner")
    kc.CornerRadius = UDim.new(1, 0)
    kc.Parent = knob

    local state = default or false
    local btn = Instance.new("TextButton")
    btn.Size             = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text             = ""
    btn.Parent           = frame

    btn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            Tween(knobBg, {BackgroundColor3 = GREEN})
            Tween(knob,   {Position = UDim2.new(1, -17, 0.5, -7)})
        else
            Tween(knobBg, {BackgroundColor3 = Color3.fromRGB(80,80,90)})
            Tween(knob,   {Position = UDim2.new(0, 3, 0.5, -7)})
        end
        if onToggle then onToggle(state) end
    end)
    return frame, function() return state end
end

local function MakeSlider(parent, text, min, max, default, onChange)
    local frame = Instance.new("Frame")
    frame.Size             = UDim2.new(1, 0, 0, 44)
    frame.BackgroundColor3 = BG_LIGHT
    frame.BorderSizePixel  = 0
    frame.Parent           = parent
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local lbl = Instance.new("TextLabel")
    lbl.Size               = UDim2.new(1, -50, 0, 20)
    lbl.Position           = UDim2.new(0, 10, 0, 2)
    lbl.BackgroundTransparency = 1
    lbl.Text               = text
    lbl.TextColor3         = TEXT_COL
    lbl.Font               = Enum.Font.GothamMedium
    lbl.TextSize           = 12
    lbl.TextXAlignment     = Enum.TextXAlignment.Left
    lbl.Parent             = frame

    local valLbl = Instance.new("TextLabel")
    valLbl.Size           = UDim2.new(0, 44, 0, 20)
    valLbl.Position       = UDim2.new(1, -50, 0, 2)
    valLbl.BackgroundTransparency = 1
    valLbl.Text           = tostring(default)
    valLbl.TextColor3     = ACCENT
    valLbl.Font           = Enum.Font.GothamBold
    valLbl.TextSize       = 12
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.Parent         = frame

    local track = Instance.new("Frame")
    track.Size             = UDim2.new(1, -20, 0, 4)
    track.Position         = UDim2.new(0, 10, 1, -14)
    track.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    track.BorderSizePixel  = 0
    track.Parent           = frame
    local tc = Instance.new("UICorner")
    tc.CornerRadius = UDim.new(1, 0)
    tc.Parent = track

    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new((default - min)/(max - min), 0, 1, 0)
    fill.BackgroundColor3 = ACCENT
    fill.BorderSizePixel  = 0
    fill.Parent           = track
    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(1, 0)
    fc.Parent = fill

    local thumb = Instance.new("Frame")
    thumb.Size             = UDim2.new(0, 12, 0, 12)
    thumb.Position         = UDim2.new((default - min)/(max - min), -6, 0.5, -6)
    thumb.BackgroundColor3 = Color3.new(1, 1, 1)
    thumb.BorderSizePixel  = 0
    thumb.Parent           = track
    local thc = Instance.new("UICorner")
    thc.CornerRadius = UDim.new(1, 0)
    thc.Parent = thumb

    local value = default
    local sliding = false

    local function UpdateSlider(x)
        local trackAbsPos  = track.AbsolutePosition
        local trackAbsSize = track.AbsoluteSize
        local ratio = math.clamp((x - trackAbsPos.X) / trackAbsSize.X, 0, 1)
        value = math.floor(min + (max - min) * ratio)
        fill.Size  = UDim2.new(ratio, 0, 1, 0)
        thumb.Position = UDim2.new(ratio, -6, 0.5, -6)
        valLbl.Text = tostring(value)
        if onChange then onChange(value) end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
            UpdateSlider(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
            UpdateSlider(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = false
        end
    end)

    return frame
end

