local TIER_COLS  = {C_COM, C_RAR, C_EXO}
local TIER_NAMES = {"Common Seeds", "Rare Seeds", "Exotic"}
local lastSeedTier = 0

local function giveSeed(iname, tier)
    local RS = safeGet("ReplicatedStorage")
    if not RS then return false, "No ReplicatedStorage" end
    local locs
    if tier == 3 then
        locs = {RS:FindFirstChild("SpecialFruits"), RS}
    else
        locs = {RS:FindFirstChild("Seeds"), RS:FindFirstChild("Crops"), RS}
    end
    for _,loc in ipairs(locs) do
        if loc then
            local item = loc:FindFirstChild(iname)
            if item then
                local ok,err = pcall(cloneToPlayer, item)
                return ok, ok and ("Gave: "..iname.." ✓") or tostring(err)
            end
        end
    end
    return false, iname.." not found in game"
end

for idx,info in ipairs(SEEDS) do
    local dname, iname, tier = info[1], info[2], info[3]
    local col = TIER_COLS[tier]
    if tier ~= lastSeedTier then
        lastSeedTier = tier
        makeSectionLabel(TIER_NAMES[tier], col, SeedInner, idx*10-1)
    end
    local btn = makeItemBtn(dname, col, SeedInner, idx*10)
    local cn,ct,cb,cd = iname,tier,btn,dname
    btn.MouseButton1Click:Connect(function()
        cb.Text = "Giving…"
        local ok,msg = giveSeed(cn,ct)
        setStatus(SeedStatus, msg, ok)
        cb.Text = cd
        if ok then flash(cb,TIER_COLS[ct]) end
    end)
end

